# ==========================================
# TELEGRAM
# ==========================================
# Docs: https://core.telegram.org/bots/tutorial
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789

# ==========================================
# PAYMENTS (YooKassa)
# ==========================================
# Docs: https://yookassa.ru/developers/api
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# ==========================================
# WEBHOOK (YooKassa)
# ==========================================
# Слушает только петлю: наружу webhook публикует Nginx (proxy_pass на этот адрес).
# 0.0.0.0 здесь ставить нельзя — порт станет доступен в обход reverse proxy.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
# Секрет адреса уведомлений: он же хвост URL в личном кабинете ЮKassa
# (https://.../webhook/yookassa?token=<значение>). Генерация: openssl rand -hex 32.
# Пока пусто, вебхук отвечает 400 на любое уведомление.
WEBHOOK_SECRET_TOKEN=

# ==========================================
# WEB ADMIN PANEL
# ==========================================
# Панель слушает только петлю; снаружи — ssh-туннель или reverse proxy с TLS.
WEB_HOST=127.0.0.1
WEB_PORT=5001
ADMIN_WEB_PASSWORD=change_me

# ==========================================
# DATABASE & LOGS
# ==========================================
DB_PATH=data/shopbot.db
LANGUAGE=ru
